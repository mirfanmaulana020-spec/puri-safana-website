"use client";

import { Suspense, useMemo, useState } from "react";
import { Canvas, ThreeEvent } from "@react-three/fiber";
import { OrbitControls, Text, Environment, ContactShadows } from "@react-three/drei";
import {
  blocks,
  units,
  houseTypes,
  rukoList,
  statusColor,
  statusLabel,
  type Unit,
  type UnitStatus,
} from "@/lib/data";

const UNIT_SIZE = 1.6;
const GAP = 0.25;
const STEP = UNIT_SIZE + GAP;

interface HouseMeshProps {
  unit: Unit;
  position: [number, number, number];
  onSelect: (unit: Unit) => void;
  selected: boolean;
}

function HouseMesh({ unit, position, onSelect, selected }: HouseMeshProps) {
  const color = statusColor[unit.status];
  const height = 0.9;

  const handleClick = (e: ThreeEvent<MouseEvent>) => {
    e.stopPropagation();
    onSelect(unit);
  };

  return (
    <group position={position}>
      <mesh
        position={[0, height / 2, 0]}
        onClick={handleClick}
        onPointerOver={(e) => {
          e.stopPropagation();
          document.body.style.cursor = "pointer";
        }}
        onPointerOut={() => {
          document.body.style.cursor = "default";
        }}
        castShadow
        receiveShadow
      >
        <boxGeometry args={[UNIT_SIZE * 0.9, height, UNIT_SIZE * 0.9]} />
        <meshStandardMaterial
          color={color}
          emissive={selected ? "#a3d139" : "#000000"}
          emissiveIntensity={selected ? 0.5 : 0}
        />
      </mesh>
      {/* roof */}
      <mesh position={[0, height + 0.18, 0]} rotation={[0, Math.PI / 4, 0]} castShadow>
        <coneGeometry args={[UNIT_SIZE * 0.68, 0.36, 4]} />
        <meshStandardMaterial color="#5c4a3a" />
      </mesh>
    </group>
  );
}

function BlockLabel({ code, position }: { code: string; position: [number, number, number] }) {
  return (
    <Text
      position={position}
      fontSize={0.55}
      color="#1c2317"
      anchorX="center"
      anchorY="bottom"
      outlineWidth={0.02}
      outlineColor="#ffffff"
    >
      {code}
    </Text>
  );
}

function Ground() {
  return (
    <mesh rotation={[-Math.PI / 2, 0, 0]} position={[0, -0.02, 0]} receiveShadow>
      <planeGeometry args={[80, 60]} />
      <meshStandardMaterial color="#33422c" />
    </mesh>
  );
}

interface SceneProps {
  filterType: string | null;
  filterStatus: UnitStatus | null;
  selected: Unit | null;
  onSelect: (unit: Unit) => void;
}

function Scene({ filterType, filterStatus, selected, onSelect }: SceneProps) {
  const items = useMemo(() => {
    const out: { unit: Unit; position: [number, number, number] }[] = [];
    blocks.forEach((block) => {
      const blockUnits = units.filter((u) => u.block === block.code);
      blockUnits.forEach((unit) => {
        const x = block.x + unit.gridX * STEP;
        const z = block.z + unit.gridZ * STEP;
        out.push({ unit, position: [x, 0, z] });
      });
    });
    return out;
  }, []);

  const visible = items.filter(({ unit }) => {
    if (filterType && unit.typeSlug !== filterType) return false;
    if (filterStatus && unit.status !== filterStatus) return false;
    return true;
  });

  return (
    <>
      <ambientLight intensity={0.65} />
      <directionalLight
        position={[15, 20, 10]}
        intensity={1.1}
        castShadow
        shadow-mapSize={[2048, 2048]}
      />
      <Ground />
      {items.map(({ unit, position }) => {
        const isVisible = visible.some((v) => v.unit.code === unit.code);
        if (!isVisible) return null;
        return (
          <HouseMesh
            key={unit.code}
            unit={unit}
            position={position}
            onSelect={onSelect}
            selected={selected?.code === unit.code}
          />
        );
      })}
      {blocks.map((block) => (
        <BlockLabel key={block.code} code={block.code} position={[block.x - 0.4, 0.05, block.z - 0.6]} />
      ))}
      <ContactShadows position={[0, 0, 0]} opacity={0.35} scale={60} blur={2} far={10} />
    </>
  );
}

export default function SitePlan3D() {
